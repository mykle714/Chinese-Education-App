# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (all .env files and variants)
.env
.env.*
**/.env
**/.env.*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment and credential files
*env-values*

# Local data dumps
/dump

# Database backup dumps (large; contain real user data — never commit)
database/backups/

# Spanish source data is a nested git clone (doozan/spanish_data, ~151MB with its
# own .git). It's reference input for server/scripts/import-esdict-temp.ts only —
# never needed at runtime or on prod. Re-clone locally if you need to re-import.
data/dictionaries/spanish_data/

# Machine-specific identity file (not committed — each machine has its own copy)
amIOnTheProdMachine.md

# Local Claude Code settings (may contain secrets)
.claude/settings.local.json

# Claude Code git worktrees (temporary isolated checkouts; never committed)
.claude/worktrees/

# Backfill script parse caches (derived artifacts, rebuilt with --refresh)
server/scripts/backfill/**/.cache/

# Prod det snapshots taken before each oracle-backfill run (large, regenerable)
server/backups/

# Character-decomposition source (makemeahanzi, LGPLv3) — build-time input for
# backfill-character-components.js. Fetched on demand; deliberately NOT vendored,
# so the LGPL data never enters this repo or ships to a client. See
# server/scripts/backfill/chinese/lib/decompose.js.
data/hanzi/cache/

# Ad-hoc debugging screenshots at the repo root (docs/ images are still tracked).
/screenshot*.png
# Downloaded installer binaries — fetch from upstream instead of committing.
/*.deb
